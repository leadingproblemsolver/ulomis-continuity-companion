{
  "name": "Advisory Loop - Record Outcome and Brief",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "advisory/outcome",
        "responseMode": "responseNode"
      },
      "id": "webhook-outcome",
      "name": "Record Outcome",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/advisory_attempts'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({action_id: $json.body.action_id, observed_result: $json.body.observed_result, attempt_status: $json.body.attempt_status, next_transition: $json.body.next_transition || null}) }}"
      },
      "id": "create-attempt",
      "name": "Create Attempt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/advisory_receipts'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({attempt_id: $json[0].id, receipt_type: $('Record Outcome').item.json.body.receipt_type || 'TEXT', receipt_value: $('Record Outcome').item.json.body.receipt_value || $('Record Outcome').item.json.body.observed_result}) }}"
      },
      "id": "create-receipt",
      "name": "Create Receipt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/advisory_actions?id=eq.' + $('Record Outcome').item.json.body.action_id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({status: $('Record Outcome').item.json.body.action_status || ($('Record Outcome').item.json.body.attempt_status === 'SUCCESS' ? 'DONE' : 'IN_PROGRESS')}) }}"
      },
      "id": "update-action",
      "name": "Update Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/advisory_actions?select=id,title,next_step,success_criteria,status,due_at,advisory_sessions!inner(id,raw_guidance,occurred_at,advisor_id,advisors!inner(name,channel))&id=eq.' + $('Record Outcome').item.json.body.action_id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            }
          ]
        }
      },
      "id": "load-context",
      "name": "Load Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const row=$json[0]; const s=row.advisory_sessions; const advisor=s.advisors; const b=$('Record Outcome').item.json.body; const lines=['Advisor: '+advisor.name,'Last interaction: '+s.occurred_at,'Advice received: '+s.raw_guidance,'Action committed: '+row.title+' — '+row.next_step,'Observed result: '+b.observed_result,'Evidence: '+(b.receipt_value||b.observed_result),'What changed: '+(b.what_changed||'Not yet recorded'),'Still unknown: '+(b.still_unknown||'None recorded'),'Next question / ask: '+(b.next_question||'None recorded'),'Next irreversible transition: '+(b.next_transition||'Not yet set')]; return [{json:{advisor_id:s.advisor_id,brief_markdown:lines.join('\\n\\n')}}];"
      },
      "id": "build-brief",
      "name": "Build Brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/advisory_briefs'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}"
      },
      "id": "save-brief",
      "name": "Save Brief",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {ok:true, brief:$json[0].brief_markdown} }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1680,
        0
      ]
    }
  ],
  "connections": {
    "Record Outcome": {
      "main": [
        [
          {
            "node": "Create Attempt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Attempt": {
      "main": [
        [
          {
            "node": "Create Receipt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Receipt": {
      "main": [
        [
          {
            "node": "Update Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Action": {
      "main": [
        [
          {
            "node": "Load Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Context": {
      "main": [
        [
          {
            "node": "Build Brief",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Brief": {
      "main": [
        [
          {
            "node": "Save Brief",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Brief": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}