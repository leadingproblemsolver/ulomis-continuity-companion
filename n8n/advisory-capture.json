{
  "name": "Advisory Loop - Capture Guidance",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "advisory/capture",
        "responseMode": "responseNode"
      },
      "id": "webhook-capture",
      "name": "Capture Guidance",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/advisors?on_conflict=name,channel,handle'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({name: $json.body.advisor_name, channel: $json.body.channel || 'LinkedIn', handle: $json.body.handle || null}) }}"
      },
      "id": "upsert-advisor",
      "name": "Upsert Advisor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/advisory_sessions'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({advisor_id: $json[0].id, raw_guidance: $('Capture Guidance').item.json.body.raw_guidance, source_url: $('Capture Guidance').item.json.body.source_url || null, ask: $('Capture Guidance').item.json.body.ask || null}) }}"
      },
      "id": "create-session",
      "name": "Create Session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/advisory_actions'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({session_id: $json[0].id, title: $('Capture Guidance').item.json.body.action_title, next_step: $('Capture Guidance').item.json.body.next_step, success_criteria: $('Capture Guidance').item.json.body.success_criteria, due_at: $('Capture Guidance').item.json.body.due_at || null, status: 'OPEN', receipt_required: $('Capture Guidance').item.json.body.receipt_required !== false}) }}"
      },
      "id": "create-action",
      "name": "Create Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {ok: true, action: $json[0]} }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        960,
        0
      ]
    }
  ],
  "connections": {
    "Capture Guidance": {
      "main": [
        [
          {
            "node": "Upsert Advisor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upsert Advisor": {
      "main": [
        [
          {
            "node": "Create Session",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Session": {
      "main": [
        [
          {
            "node": "Create Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Action": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}